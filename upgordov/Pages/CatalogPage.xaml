<Page x:Class="upgordov.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг"
      Background="#F8F9FA"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A56D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поля ввода -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="110"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Тень для карточек -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтров -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="Каталог книг" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12" Foreground="#212529"/>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Поиск -->
                    <TextBox x:Name="TxtSearch" Style="{StaticResource RoundedTextBox}" Width="200" Margin="0,0,10,0" 
                             TextChanged="TxtSearch_TextChanged"/>

                    <!-- Жанр -->
                    <ComboBox x:Name="CbGenre" Style="{StaticResource RoundedComboBox}" Width="150" Margin="0,0,10,0" 
                              DisplayMemberPath="GenreName" SelectedValuePath="GenreID"/>

                    <!-- Кнопка поиска -->
                    <Button Content="Поиск" Style="{StaticResource PrimaryButton}" Width="76" Click="BtnSearch_Click"/>

                    <Separator Width="1" Background="#DEE2E6" Margin="10,0"/>

                    <!-- Сортировка -->
                    <TextBlock Text="Сортировка:" VerticalAlignment="Center" Foreground="#495057" Margin="10,0,8,0"/>

                    <Button Content="По имени" Style="{StaticResource PrimaryButton}" Width="100" Margin="0,0,8,0" Click="SortByName_Click"/>
                    <Button Content="По рейтингу" Style="{StaticResource PrimaryButton}" Width="110" Margin="0,0,15,0" Click="SortByRating_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Таблица книг -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="5" Effect="{StaticResource CardShadow}">
            <Grid>
                <DataGrid x:Name="DgBooks" Style="{StaticResource ModernDataGrid}" 
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          MouseDoubleClick="DgBooks_MouseDoubleClick" SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <!-- Обложка -->
                        <DataGridTemplateColumn Header="Обложка" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E9ECEF" BorderThickness="1" Margin="8" CornerRadius="6" Background="#F8F9FA">
                                        <Image Source="{Binding CoverPath}" Width="80" Height="100" Stretch="UniformToFill" 
                                               StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Название + Автор -->
                        <DataGridTemplateColumn Header="Название" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="5,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="#212529" 
                                                   TextWrapping="Wrap" MaxHeight="40"/>
                                        <TextBlock Text="{Binding Author}" Foreground="#6C757D" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Жанры -->
                        <DataGridTextColumn Header="Жанры" Binding="{Binding Genres}" Width="*"/>

                        <!-- Рейтинг -->
                        <DataGridTemplateColumn Header="⭐ Рейтинг" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="⭐" FontSize="14" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding AvgRating, StringFormat={}{0:0.0}}" 
                                                   FontWeight="SemiBold" Foreground="#F6B400" FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Действия -->
                        <DataGridTemplateColumn Header="Действия" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="➕" Style="{StaticResource PrimaryButton}" Width="50" Height="28" FontSize="12"
                                            ToolTip="В список" Click="AddToList_Click" Tag="{Binding BookID}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Пустое состояние -->
                <StackPanel x:Name="PnlNoBooks" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Книги не найдены" FontWeight="Medium" 
                               Foreground="#6C757D" Margin="0,12,0,6" HorizontalAlignment="Center"/>
                    <TextBlock Text="Попробуйте изменить параметры поиска" 
                               Foreground="#ADB5BD" FontSize="13" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" 
                   Background="Transparent" BorderThickness="0" Padding="10,5">
            <TextBlock x:Name="LblStatus" Foreground="#6C757D" FontSize="12"/>
        </StatusBar>
    </Grid>
</Page>