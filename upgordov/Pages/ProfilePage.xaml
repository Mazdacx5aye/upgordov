<Page x:Class="upgordov.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мой профиль"
      Background="#F8F9FA"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A56D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4361EE"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#4361EE"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E7F1FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поля ввода -->
        <Style x:Key="RoundedInput" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4361EE"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="45"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Бейджи статуса -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 👤 Информация о пользователе -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Border Width="50" Height="50" Background="#E7F1FF" CornerRadius="25">
                            <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TbUserName" Text="Пользователь" FontWeight="SemiBold" FontSize="18"/>
                            <TextBlock x:Name="TbUserRole" Text="Роль: Читатель" Foreground="#6C757D" FontSize="13"/>
                        </StackPanel>
                        <Border x:Name="BadgeStatus" Style="{StaticResource StatusBadge}" Background="#D4EDDA" 
                                Margin="20,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="✅ Активен" Foreground="#155724" FontSize="12" FontWeight="Medium"/>
                        </Border>
                        <Border x:Name="BadgeFrozen" Style="{StaticResource StatusBadge}" Background="#F8D7DA" 
                                Margin="20,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="❄️ Заморожен" Foreground="#721C24" FontSize="12" FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TbInfo" FontSize="14" Foreground="#495057" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ⚙️ Управление профилем -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Управление профилем" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,15"/>

                    <!-- Предупреждение о заморозке -->
                    <Border x:Name="PnlFreezeWarn" Background="#FFF3CD" BorderBrush="#FFEEBA" 
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TbFreezeWarn" Foreground="#856404" FontSize="13" 
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Оспаривание заморозки -->
                    <Border x:Name="PnlAppeal" Background="#E7F1FF" BorderBrush="#B3D7FF" 
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="📬 Оспаривание заморозки" FontWeight="Medium" 
                                       Foreground="#004085" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="TxtAppealReason" Style="{StaticResource RoundedInput}" 
                                         Width="250" Height="42" VerticalAlignment="Center"/>
                                <Button Content="📤 Отправить апелляцию" Style="{StaticResource OutlineButton}" 
                                        Margin="10,0,0,0" VerticalAlignment="Center" Click="AppealFreeze_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Заявка на роль автора -->
                    <StackPanel>
                        <TextBlock Text="Стать автором" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtRoleReason" Style="{StaticResource RoundedInput}" 
                                     Width="250" Height="42" VerticalAlignment="Center"/>
                            <Button Content="Отправить заявку" Style="{StaticResource PrimaryButton}" 
                                    Margin="10,0,0,0" VerticalAlignment="Center" Click="RequestRole_Click"/>
                        </StackPanel>
                        <TextBlock Text="Укажите причину, по которой вы хотите стать автором" 
                                   Foreground="#6C757D" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 💬 Мои отзывы -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Мои отзывы" FontWeight="SemiBold" FontSize="16"/>
                        
                    </StackPanel>

                    <DataGrid x:Name="DgMyReviews" Grid.Row="1" Style="{StaticResource ModernDataGrid}" Height="200"/>

                    <StackPanel x:Name="PnlNoReviews" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Grid.Row="1" Visibility="Collapsed">
                        <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Пока нет отзывов" FontWeight="Medium" Foreground="#6C757D" Margin="0,8,0,4"/>
                        <TextBlock Text="Оцените прочитанные книги" Foreground="#ADB5BD" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>