<Page x:Class="upgordov.Pages.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Просмотр книги"
      Background="#F8F9FA"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A56D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C82333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#218838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поля ввода -->
        <Style x:Key="RoundedInput" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4361EE"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Карточка -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="60"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 📚 Заголовок книги -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="TbTitle" Text="Название книги" 
                               FontWeight="SemiBold" FontSize="24" Foreground="#212529" 
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TbMeta" Text="Автор • Жанр • Дата" 
                               Foreground="#6C757D" FontStyle="Italic" FontSize="14"/>

                    <!-- Рейтинг книги -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="⭐" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbAvgRating" Text="0.0" FontWeight="SemiBold" 
                                   Foreground="#F6B400" FontSize="16" Margin="4,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbReviewsCount" Text="(0 отзывов)" 
                                   Foreground="#6C757D" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 📖 Содержимое книги -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Содержание" FontWeight="SemiBold" FontSize="16" 
                               Margin="0,0,0,12" Foreground="#212529"/>
                    <Border Background="#F8F9FA" CornerRadius="8" Padding="15" BorderBrush="#E9ECEF" BorderThickness="1">
                        <TextBox x:Name="TbContent" IsReadOnly="True" TextWrapping="Wrap" 
                                 Background="Transparent" BorderThickness="0" FontSize="14" 
                                 Foreground="#495057" Height="200" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ⚠️ Жалобы и модерация -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Сообщить о проблеме" FontWeight="SemiBold" FontSize="16" 
                               Margin="0,0,0,12" Foreground="#212529"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="TxtBookComplaint" Style="{StaticResource RoundedInput}" 
                                 Width="220" Height="42" VerticalAlignment="Center"/>

                        <Button Content="Жалоба на книгу" Style="{StaticResource DangerButton}" 
                                Margin="10,0,8,0" Click="ComplainBook_Click"/>

                        <Button Content="Жалоба на автора" Style="{StaticResource DangerButton}" 
                                Margin="0,0,15,0" Click="ComplainAuthor_Click"/>

                        <Button x:Name="BtnFreezeBook" Content="❄️ Заморозить книгу" 
                                Style="{StaticResource DangerButton}"
                                Visibility="Collapsed" Click="FreezeBook_Click"/>
                    </StackPanel>

                   
                </StackPanel>
            </Border>

            <!-- ✍️ Форма отзыва -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Оставить отзыв" FontWeight="SemiBold" FontSize="16" 
                               Margin="0,0,0,15" Foreground="#212529"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ваш отзыв:" Grid.Row="0" Grid.Column="0" 
                                   VerticalAlignment="Top" Margin="0,8,10,0" FontWeight="Medium"/>
                        <TextBox x:Name="TxtReviewText" Grid.Row="0" Grid.Column="1" 
                                 Style="{StaticResource RoundedInput}" Height="80" TextWrapping="Wrap" 
                                 AcceptsReturn="True" VerticalAlignment="Top"/>

                        <TextBlock Text="Оценка:" Grid.Row="1" Grid.Column="0" 
                                   VerticalAlignment="Center" Margin="0,10,10,0" FontWeight="Medium"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="CbRating" Style="{StaticResource RoundedComboBox}" 
                                      Width="70" Margin="0,0,10,0">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10" IsSelected="True"/>
                            </ComboBox>
                            <TextBlock Text="из 10" Foreground="#6C757D" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="📤 Опубликовать отзыв" Grid.Row="2" Grid.Column="1" 
                                Style="{StaticResource SuccessButton}" Width="180" 
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddReview_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 💬 Список отзывов -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="💬 Отзывы читателей" FontWeight="SemiBold" FontSize="16" Foreground="#212529"/>
                        <TextBlock x:Name="LblReviewsHeader" Text="(0)" Foreground="#6C757D" 
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="DgReviews" Grid.Row="1" Style="{StaticResource ModernDataGrid}" 
                              Height="200" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <!-- Пользователь -->
                            <DataGridTemplateColumn Header="👤 Пользователь" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" Background="#E7F1FF" CornerRadius="16" Margin="0,0,8,0">
                                                <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding User}" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Рейтинг -->
                            <DataGridTemplateColumn Header="⭐ Оценка" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⭐" FontSize="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Rating}" FontWeight="SemiBold" 
                                                       Foreground="#F6B400" FontSize="14"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Текст отзыва -->
                            <DataGridTextColumn Header="📝 Отзыв" Binding="{Binding ReviewText}" Width="2*"/>

                            <!-- Дата -->
                            <DataGridTextColumn Header="📅 Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>

                            <!-- Жалоба на отзыв -->
                            <DataGridTemplateColumn Header="⚡" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚠️ Жалоба" Style="{StaticResource DangerButton}" 
                                                Click="ComplainReview_Click" Tag="{Binding ReviewID}"
                                                Padding="8,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Заморозка отзыва (для админов) -->
                            <DataGridTemplateColumn Header="🔐" Width="100" x:Name="ColAdminReview">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="❄️ Заморозить" Style="{StaticResource DangerButton}" 
                                                Click="FreezeReview_Click" Tag="{Binding ReviewID}"
                                                Padding="8,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- Пустое состояние -->
                        <StackPanel x:Name="PnlNoReviews" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                    Grid.Row="1" Visibility="Collapsed">
                            <TextBlock Text="💭" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Пока нет отзывов" FontWeight="Medium" 
                                       Foreground="#6C757D" Margin="0,10,0,5" HorizontalAlignment="Center"/>
                            <TextBlock Text="Будьте первым, кто оставит отзыв!" 
                                       Foreground="#ADB5BD" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>