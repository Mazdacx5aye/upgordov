<Page x:Class="upgordov.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет автора"
      Background="#F8F9FA"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Кнопки -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A56D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#218838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0A800"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поля ввода -->
        <Style x:Key="RoundedInput" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4361EE"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 📝 Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Страница автора" FontWeight="SemiBold" FontSize="24" Foreground="#212529"/>
                <TextBlock x:Name="TbAuthorInfo" Text="Добро пожаловать!" Foreground="#6C757D" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 📚 Форма добавления книги -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Добавить новую книгу" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,15" Foreground="#212529"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Width="220" Margin="0,0,10,0">
                            <TextBlock Text="Название книги" FontWeight="Medium" Foreground="#495057" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtNewTitle" Style="{StaticResource RoundedInput}" Height="42"/>
                        </StackPanel>

                        <StackPanel Width="350" Margin="0,0,10,0">
                            <TextBlock Text="Краткое описание" FontWeight="Medium" Foreground="#495057" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtNewContent" Style="{StaticResource RoundedInput}" Height="42" 
                                     AcceptsReturn="False" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom">
                            <Button Content="Опубликовать" Style="{StaticResource PrimaryButton}" 
                                    Height="42" Width="140" Click="AddNewBook_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 📋 Мои книги -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок с количеством -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="📚 Мои книги" FontWeight="SemiBold" FontSize="16" Foreground="#212529"/>
                        <TextBlock x:Name="LblBooksCount" Text="(0)" Foreground="#6C757D" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Таблица книг -->
                    <DataGrid x:Name="DgMyBooks" Grid.Row="1" Style="{StaticResource ModernDataGrid}" 
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <!-- Название -->
                            <DataGridTemplateColumn Header="📖 Книга" Width="2.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="5,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="#212529" 
                                                       TextWrapping="Wrap" MaxHeight="40"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#6C757D" 
                                                       FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Статус -->
                            <DataGridTemplateColumn Header="📊 Статус" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="20" Padding="8,4" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D4EDDA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Опубликовано">
                                                            <Setter Property="Background" Value="#D4EDDA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="На модерации">
                                                            <Setter Property="Background" Value="#FFF3CD"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Заморожено">
                                                            <Setter Property="Background" Value="#F8D7DA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#155724"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Опубликовано">
                                                                <Setter Property="Text" Value="✅ Опубликовано"/>
                                                                <Setter Property="Foreground" Value="#155724"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="На модерации">
                                                                <Setter Property="Text" Value="⏳ На проверке"/>
                                                                <Setter Property="Foreground" Value="#856404"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Заморожено">
                                                                <Setter Property="Text" Value="❄️ Заморожено"/>
                                                                <Setter Property="Foreground" Value="#721C24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Дата -->
                            <DataGridTextColumn Header="📅 Дата" Binding="{Binding PublishDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>

                            <!-- Действия -->
                            <DataGridTemplateColumn Header="⚡ Действия" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- Кнопка редактирования -->
                                            <Button Content="✏️ Редактировать" Style="{StaticResource WarningButton}" 
                                                    Click="EditBook_Click" Tag="{Binding BookID}"
                                                    Margin="0,0,5,0" Padding="8,4" FontSize="11"/>

                                            <!-- Кнопка оспаривания (показывается если заморожено) -->
                                            <Button Content="📬 Оспорить" Click="AppealBookFreeze_Click" Tag="{Binding BookID}"
                                                    Padding="8,4" FontSize="11">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Заморожено">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Пустое состояние -->
                    <StackPanel x:Name="PnlNoBooks" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Grid.Row="1" Visibility="Collapsed">
                        <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="У вас пока нет книг" FontWeight="Medium" 
                                   Foreground="#6C757D" Margin="0,12,0,6" HorizontalAlignment="Center"/>
                        <TextBlock Text="Добавьте первую книгу с помощью формы выше" 
                                   Foreground="#ADB5BD" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>