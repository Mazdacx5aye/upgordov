<Page x:Class="upgordov.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора"
      Background="#F8F9FA"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Кнопки действий -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#218838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C82333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Background" Value="#17A2B8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#138496"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox для ролей -->
        <Style x:Key="RoleComboBox" TargetType="ComboBox">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="AdminDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="45"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- Заголовки колонок -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#343A40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Карточка для вкладок -->
        <Style x:Key="TabCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль TabControl -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Стиль TabItem -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="Transparent" BorderThickness="0" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#4361EE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F8F9FA">
        <TabControl Style="{StaticResource ModernTabControl}">

            <!-- 🔔 Вкладка: Жалобы -->
            <TabItem Style="{StaticResource ModernTabItem}" Header="Жалобы">
                <Border Style="{StaticResource TabCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель поиска -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="TxtSearchComplaints" Width="200" Padding="8,6" 
                                     BorderBrush="#DEE2E6" VerticalContentAlignment="Center"/>
                            <Button Content="🔍" Width="40" Margin="5,0,0,0" 
                                    Background="#4361EE" Foreground="White" BorderThickness="0"/>
                            <TextBlock Text="Всего:" Foreground="#6C757D" Margin="20,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblComplaintsCount" Text="0" FontWeight="SemiBold" 
                                       Foreground="#212529" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Таблица жалоб -->
                        <DataGrid x:Name="DgComplaints" Grid.Row="1" Style="{StaticResource AdminDataGrid}" 
                                  IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="👤 Отправитель" Binding="{Binding Sender}" Width="*"/>
                                <DataGridTextColumn Header="📋 Тип" Binding="{Binding TargetType}" Width="120"/>
                                <DataGridTextColumn Header="📝 Причина" Binding="{Binding Reason}" Width="2*"/>
                                <DataGridTextColumn Header="📅 Дата" Binding="{Binding ComplaintDate, StringFormat={}{0:dd.MM.yy}}" Width="100"/>
                                <DataGridTemplateColumn Header="⚡ Действия" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✅ Принять" Style="{StaticResource SuccessButton}" 
                                                        Click="AcceptComplaint_Click" Tag="{Binding ComplaintID}"
                                                        Margin="0,0,5,0" ToolTip="Подтвердить жалобу"/>
                                                <Button Content="❌ Отклонить" Style="{StaticResource DangerButton}" 
                                                        Click="RejectComplaint_Click" Tag="{Binding ComplaintID}"
                                                        ToolTip="Отклонить жалобу"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ❄️ Вкладка: Заявки на разморозку -->
            <TabItem Style="{StaticResource ModernTabItem}" Header="Разморозка">
                <Border Style="{StaticResource TabCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Ожидают:" Foreground="#6C757D" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblUnfreezeCount" Text="0" FontWeight="SemiBold" Foreground="#212529"/>
                        </StackPanel>

                        <DataGrid x:Name="DgUnfreezeRequests" Grid.Row="1" Style="{StaticResource AdminDataGrid}" 
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="👤 Пользователь" Binding="{Binding UserName}" Width="*"/>
                                <DataGridTextColumn Header="📋 Тип" Binding="{Binding TargetType}" Width="100"/>
                                <DataGridTextColumn Header="🎯 Объект" Binding="{Binding TargetName}" Width="*"/>
                                <DataGridTextColumn Header="📝 Причина" Binding="{Binding Reason}" Width="2*"/>
                                <DataGridTextColumn Header="📅 Дата" Binding="{Binding RequestDate, StringFormat={}{0:dd.MM.yy}}" Width="100"/>
                                <DataGridTemplateColumn Header="⚡ Действия" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✅ Разморозить" Style="{StaticResource SuccessButton}" 
                                                        Click="ApproveUnfreeze_Click" Tag="{Binding RequestID}"
                                                        Margin="0,0,5,0"/>
                                                <Button Content="❌ Отклонить" Style="{StaticResource DangerButton}" 
                                                        Click="RejectUnfreeze_Click" Tag="{Binding RequestID}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 🎭 Вкладка: Заявки на роль -->
            <TabItem Style="{StaticResource ModernTabItem}" Header="Заявки на роль">
                <Border Style="{StaticResource TabCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Новых заявок:" Foreground="#6C757D" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblRoleRequestsCount" Text="0" FontWeight="SemiBold" Foreground="#212529"/>
                        </StackPanel>

                        <DataGrid x:Name="DgRoleRequests" Grid.Row="1" Style="{StaticResource AdminDataGrid}" 
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="👤 Пользователь" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="📧 Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="📝 Обоснование" Binding="{Binding Reason}" Width="2*"/>
                                <DataGridTextColumn Header="📅 Дата" Binding="{Binding RequestDate, StringFormat={}{0:dd.MM.yy}}" Width="100"/>
                                <DataGridTemplateColumn Header="⚡ Решение" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✅ Утвердить" Style="{StaticResource SuccessButton}" 
                                                        Click="ApproveRole_Click" Tag="{Binding RequestID}"
                                                        Margin="0,0,5,0"/>
                                                <Button Content="❌ Отклонить" Style="{StaticResource DangerButton}" 
                                                        Click="RejectRole_Click" Tag="{Binding RequestID}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 👥 Вкладка: Пользователи -->
            <TabItem Style="{StaticResource ModernTabItem}" Header="Пользователи">
                <Border Style="{StaticResource TabCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Фильтры -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="TxtSearchUsers" Width="180" Padding="8,6" 
                                     BorderBrush="#DEE2E6" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="CbFilterRole" Width="120" Margin="10,0,0,0" 
                                      Padding="8,4" BorderBrush="#DEE2E6">
                                <ComboBoxItem Content="Все роли" IsSelected="True"/>
                                <ComboBoxItem Content="Читатель"/>
                                <ComboBoxItem Content="Автор"/>
                                <ComboBoxItem Content="Модератор"/>
                                <ComboBoxItem Content="Админ"/>
                            </ComboBox>
                            <Button Content="Сбросить" Style="{StaticResource InfoButton}" 
                                    Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Таблица пользователей -->
                        <DataGrid x:Name="DgUsers" Grid.Row="1" Style="{StaticResource AdminDataGrid}" 
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="🔑 Логин" Binding="{Binding Login}" Width="*"/>
                                <DataGridTextColumn Header="👤 Имя" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="📧 Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTemplateColumn Header="🎭 Роль" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox x:Name="CbRole" Style="{StaticResource RoleComboBox}"
                                                      Tag="{Binding UserID}" SelectionChanged="ChangeRole_Click">
                                                <ComboBoxItem Content="Читатель" Tag="1"/>
                                                <ComboBoxItem Content="Автор" Tag="2"/>
                                                <ComboBoxItem Content="Модератор" Tag="3"/>
                                                <ComboBoxItem Content="Админ" Tag="4"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="❄️ Статус" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Padding="6,3" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✅ Активен"/>
                                                        <Setter Property="Foreground" Value="#28A745"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                                <Setter Property="Text" Value="❄️ Заморожен"/>
                                                                <Setter Property="Foreground" Value="#DC3545"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="⚡ Управление" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🔒 Заморозить" Style="{StaticResource DangerButton}" 
                                                    Click="FreezeUser_Click" Tag="{Binding UserID}"
                                                    Padding="8,4" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Page>