<Page x:Class="upgordov.Pages.ReadingListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои списки чтения"
      Background="#F8F9FA"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- ComboBox -->
        <Style x:Key="StatusComboBox" TargetType="ComboBox">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Карточка -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="Transparent" BorderThickness="0" CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#4361EE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 📚 Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <TextBlock Text="Мои списки чтения" FontWeight="SemiBold" FontSize="22" Foreground="#212529"/>
            <TextBlock x:Name="TbSubtitle" Text="Управляйте своими книгами" Foreground="#6C757D" FontSize="14"/>
        </StackPanel>

        <!-- 🗂️ Вкладки статусов -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <TabControl x:Name="TcLists" Style="{StaticResource ModernTabControl}" SelectionChanged="TcLists_SelectionChanged">
                <TabItem Style="{StaticResource ModernTabItem}" Header="📋 В планах" Tag="В планах"/>
                <TabItem Style="{StaticResource ModernTabItem}" Header="📖 Читаю" Tag="Читаю"/>
                <TabItem Style="{StaticResource ModernTabItem}" Header="✅ Прочитано" Tag="Прочитано"/>
                <TabItem Style="{StaticResource ModernTabItem}" Header="❌ Заброшено" Tag="Заброшено"/>
            </TabControl>
        </Border>

        <!-- 📊 Таблица книг -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель управления -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="TxtSearch" Width="200" Padding="8,6" 
                             BorderBrush="#DEE2E6" VerticalContentAlignment="Center"/>
                    <Button Content="Поиск" Width="40" Margin="5,0,0,0" 
                            Background="#4361EE" Foreground="White" BorderThickness="0"/>
                    <TextBlock Text="Всего:" Foreground="#6C757D" Margin="20,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblBooksCount" Text="0" FontWeight="SemiBold" 
                               Foreground="#212529" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="DgLists" Grid.Row="1" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <!-- Книга -->
                        <DataGridTemplateColumn Header="📖 Книга" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="5,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" 
                                                   Foreground="#212529" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Author}" Foreground="#6C757D" 
                                                   FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Статус (бейдж) -->
                        <DataGridTemplateColumn Header="📊 Статус" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="20" Padding="6,3" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E7F1FF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="В планах">
                                                        <Setter Property="Background" Value="#E7F1FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Читаю">
                                                        <Setter Property="Background" Value="#FFF3CD"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Прочитано">
                                                        <Setter Property="Background" Value="#D4EDDA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Заброшено">
                                                        <Setter Property="Background" Value="#F8D7DA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4361EE"/>
                                                    <Setter Property="Text" Value="📋 В планах"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="В планах">
                                                            <Setter Property="Foreground" Value="#4361EE"/>
                                                            <Setter Property="Text" Value="📋 В планах"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Читаю">
                                                            <Setter Property="Foreground" Value="#856404"/>
                                                            <Setter Property="Text" Value="📖 Читаю"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Прочитано">
                                                            <Setter Property="Foreground" Value="#155724"/>
                                                            <Setter Property="Text" Value="✅ Прочитано"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Заброшено">
                                                            <Setter Property="Foreground" Value="#721C24"/>
                                                            <Setter Property="Text" Value="❌ Заброшено"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Дата добавления -->
                        <DataGridTextColumn Header="📅 Дата" Binding="{Binding AddedDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>

                        <!-- Изменить статус -->
                        <DataGridTemplateColumn Header="⚡ Статус" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="CbStatus" Style="{StaticResource StatusComboBox}"
                                              Tag="{Binding BookID}" 
                                              SelectedValue="{Binding Status, Mode=OneWay}"
                                              SelectionChanged="ChangeStatus_Click">
                                        <ComboBoxItem Content="📋 В планах" Tag="В планах"/>
                                        <ComboBoxItem Content="📖 Читаю" Tag="Читаю"/>
                                        <ComboBoxItem Content="✅ Прочитано" Tag="Прочитано"/>
                                        <ComboBoxItem Content="❌ Заброшено" Tag="Заброшено"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Пустое состояние -->
                <StackPanel x:Name="PnlNoBooks" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Grid.Row="1" Visibility="Collapsed">
                    <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="В этом списке пока нет книг" FontWeight="Medium" 
                               Foreground="#6C757D" Margin="0,12,0,6" HorizontalAlignment="Center"/>
                    <TextBlock Text="Добавляйте книги из каталога" 
                               Foreground="#ADB5BD" FontSize="13" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" 
                   Background="Transparent" BorderThickness="0" Padding="10,5">
            <TextBlock x:Name="LblStatus" Foreground="#6C757D" FontSize="12"/>
        </StatusBar>
    </Grid>
</Page>